<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.neo.iptv-streamlink</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/path/to/iptv-gateway/streamlink_gateway.py</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/path/to/iptv-gateway</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <!-- 要 1080p 的話，取消下面註解並重啟 -->
    <!--
    <key>EnvironmentVariables</key>
    <dict>
        <key>SL_STREAM</key>
        <string>1080p,best</string>
    </dict>
    -->
    <key>StandardOutPath</key>
    <string>/tmp/streamlink-gateway.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/streamlink-gateway.err.log</string>
</dict>
</plist>
